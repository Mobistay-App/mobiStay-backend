generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String             @id @default(cuid())
  email            String?            @unique
  phone            String?            @unique
  password         String
  role             UserRole           @default(TRAVELER)
  firstName        String?
  lastName         String?
  avatarUrl        String?
  isVerified       Boolean            @default(false)
  idStatus         VerificationStatus @default(UNVERIFIED)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  address          String?
  bio              String?            @db.VarChar(240)
  lastLoginAt      DateTime?
  bookings         Booking[]
  driverProfile    DriverProfile?
  ownerProfile     OwnerProfile?
  properties       Property[]
  ridesRequested   Ride[]             @relation("PassengerRides")
  verificationLogs VerificationLog[]

  @@index([role])
}

model OwnerProfile {
  id               String  @id @default(cuid())
  userId           String  @unique
  idCardUrl        String?
  verificationNote String?
  ownershipDocUrl  String?
  idBackUrl        String?
  selfieWithIdUrl  String?
  user             User    @relation(fields: [userId], references: [id])
}

model DriverProfile {
  id              String  @id @default(cuid())
  userId          String  @unique
  licenseNumber   String  @unique
  vehicleModel    String?
  vehiclePlate    String? @unique
  licenseImageUrl String?
  isOnline        Boolean @default(false)
  idCardUrl       String?
  vehicleColor    String?
  vehicleType     String?
  idBackUrl       String?
  insuranceDocUrl String?
  selfieWithIdUrl String?
  user            User    @relation(fields: [userId], references: [id])
  rides           Ride[]  @relation("DriverRides")
}

model Property {
  id            String       @id @default(cuid())
  ownerId       String
  title         String
  description   String
  address       String
  city          String
  pricePerNight Float
  images        String[]
  amenities     String[]
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  blockedDates  DateTime[]
  latitude      Float?
  longitude     Float?
  type          PropertyType @default(APARTMENT)
  bookings      Booking[]
  owner         User         @relation(fields: [ownerId], references: [id])

  @@index([city])
  @@index([type])
}

model Booking {
  id         String        @id @default(cuid())
  propertyId String
  travelerId String
  checkIn    DateTime
  checkOut   DateTime
  totalPrice Float
  status     BookingStatus @default(PENDING)
  paymentId  String?       @unique
  property   Property      @relation(fields: [propertyId], references: [id])
  traveler   User          @relation(fields: [travelerId], references: [id])
}

model Ride {
  id             String         @id @default(cuid())
  passengerId    String
  driverId       String?
  fare           Float?
  status         RideStatus     @default(REQUESTED)
  createdAt      DateTime       @default(now())
  dropoffAddress String
  dropoffLat     Float
  dropoffLng     Float
  pickupAddress  String
  pickupLat      Float
  pickupLng      Float
  updatedAt      DateTime       @updatedAt
  driver         DriverProfile? @relation("DriverRides", fields: [driverId], references: [id])
  passenger      User           @relation("PassengerRides", fields: [passengerId], references: [id])
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model VerificationLog {
  id             String             @id @default(cuid())
  userId         String
  adminId        String?
  previousStatus VerificationStatus
  newStatus      VerificationStatus
  reason         String?
  createdAt      DateTime           @default(now())
  user           User               @relation(fields: [userId], references: [id])
}

enum UserRole {
  TRAVELER
  OWNER
  DRIVER
  ADMIN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum RideStatus {
  REQUESTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PropertyType {
  APARTMENT
  STUDIO
  HOTEL
  VILLA
  OTHER
}
